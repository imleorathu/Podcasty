# Podcasty Speech Backend Configuration (DO NOT COMMIT REAL CREDENTIALS)
PORT=8443
HOST=0.0.0.0

# Google Cloud service account key path (never ship inside the Android APK!)
# Obtain from Google Cloud Console -> IAM & Admin -> Service Accounts -> Speech-to-Text Client
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/gcp-speech-service-account.json

# Comma-separated bearer tokens accepted from Podcasty Android clients
PODCASTY_API_TOKENS=replace-with-strong-random-token-1,replace-with-strong-random-token-2

# Optional native TLS (leave empty if terminating TLS at nginx/Cloud Run/Caddy)
TLS_CERT_PATH=
TLS_KEY_PATH=

# Rate limiting & safety caps
MAX_CONCURRENT_SESSIONS=20
MAX_CHUNKS_PER_MINUTE=1200
MAX_CHUNK_BYTES=32768
ALLOWED_LANGUAGES=en-US,ta-IN,en-IN,en-GB
